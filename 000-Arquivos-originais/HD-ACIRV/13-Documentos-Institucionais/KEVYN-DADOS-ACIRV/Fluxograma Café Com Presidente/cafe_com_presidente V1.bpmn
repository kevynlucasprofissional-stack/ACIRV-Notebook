<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_CafeComPresidente" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.16.0">
  <bpmn:collaboration id="Collaboration_CafeComPresidente">
    <bpmn:participant id="Participant_CafeComPresidente" name="Processo Café com o Presidente" processRef="Process_CafeComPresidente" />
  </bpmn:collaboration>
  <bpmn:process id="Process_CafeComPresidente" isExecutable="false">
    <bpmn:laneSet id="LaneSet_CafeComPresidente">
      <bpmn:lane id="Lane_Participantes" name="Participantes e Equipe ACIRV">
        <bpmn:flowNodeRef>Task_CompartilharDemandas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApresentacoesParticipantes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comunicacao" name="Comunicação">
        <bpmn:flowNodeRef>Task_Fotografar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GravarIntegralmente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CaptarBroll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentificarConteudos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParaleloFim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransferirArquivos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditarFotos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublicarCarrossel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FormatoVideo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditarCorte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditarResumoBroll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublicarPrimeiroVideo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MaterialAdicional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CicloAposVideo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlanejarReaproveitamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublicarNovosConteudos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CicloCompleto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1saja4s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DisponibilizarCriativo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CriarCriativo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comercial" name="Comercial e Relacionamento">
        <bpmn:flowNodeRef>Task_IntensificarConvites</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComplementarInformacoes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Diretoria" name="Diretoria / Presidência">
        <bpmn:flowNodeRef>StartEvent_SemanaIniciada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EventoConfirmado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerificarConfirmacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EventoNaoRealizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AberturaPresidente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParaleloInicio</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_SemanaIniciada" name="Semana do Café iniciada">
      <bpmn:outgoing>Flow_Start_Verificar</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_EventoConfirmado" name="Café com o Presidente confirmado?">
      <bpmn:incoming>Flow_Verificar_Confirmado</bpmn:incoming>
      <bpmn:outgoing>Flow_1oro78r</bpmn:outgoing>
      <bpmn:outgoing>Flow_Confirmado_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_VerificarConfirmacao" name="Verificar se o Café desta terça-feira, às 10h30, está confirmado">
      <bpmn:incoming>Flow_Start_Verificar</bpmn:incoming>
      <bpmn:outgoing>Flow_Verificar_Confirmado</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_EventoNaoRealizado" name="Evento cancelado ou adiado">
      <bpmn:incoming>Flow_Confirmado_Nao</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObjectReference_Criativo" name="Criativo oficial do convite" dataObjectRef="DataObject_Criativo" />
    <bpmn:dataObject id="DataObject_Criativo" />
    <bpmn:task id="Task_IntensificarConvites" name="Intensificar convites individuais (preferencialmente D-1)">
      <bpmn:incoming>Flow_Disponibilizar_Convites</bpmn:incoming>
      <bpmn:outgoing>Flow_Convites_Abertura</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AberturaPresidente" name="Realizar boas-vindas e apresentar a ACIRV">
      <bpmn:incoming>Flow_Convites_Abertura</bpmn:incoming>
      <bpmn:outgoing>Flow_Abertura_Paralelo</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_ParaleloInicio" name="Iniciar encontro e cobertura">
      <bpmn:incoming>Flow_Abertura_Paralelo</bpmn:incoming>
      <bpmn:outgoing>Flow_Paralelo_Fotografar</bpmn:outgoing>
      <bpmn:outgoing>Flow_Paralelo_Apresentacoes</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_ComplementarInformacoes" name="Complementar serviços, projetos e benefícios">
      <bpmn:incoming>Flow_Demandas_Complementar</bpmn:incoming>
      <bpmn:outgoing>Flow_Complementar_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Fotografar" name="Fotografar momentos e participantes">
      <bpmn:incoming>Flow_Paralelo_Fotografar</bpmn:incoming>
      <bpmn:outgoing>Flow_Fotografar_Gravar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GravarIntegralmente" name="Gravar integralmente para edição (sem live)">
      <bpmn:incoming>Flow_Fotografar_Gravar</bpmn:incoming>
      <bpmn:outgoing>Flow_Gravar_Broll</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CaptarBroll" name="Captar cenas de apoio (B-roll)">
      <bpmn:incoming>Flow_Gravar_Broll</bpmn:incoming>
      <bpmn:outgoing>Flow_Broll_Identificar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IdentificarConteudos" name="Identificar depoimentos, histórias e falas aproveitáveis">
      <bpmn:incoming>Flow_Broll_Identificar</bpmn:incoming>
      <bpmn:outgoing>Flow_Identificar_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_ParaleloFim" name="Encerrar encontro e cobertura">
      <bpmn:incoming>Flow_Complementar_Join</bpmn:incoming>
      <bpmn:incoming>Flow_0hq036o</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Transferir</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_TransferirArquivos" name="Transferir todos os arquivos para o HD externo imediatamente">
      <bpmn:incoming>Flow_Join_Transferir</bpmn:incoming>
      <bpmn:outgoing>Flow_Transferir_EditarFotos</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EditarFotos" name="Selecionar e editar as melhores fotografias">
      <bpmn:incoming>Flow_Transferir_EditarFotos</bpmn:incoming>
      <bpmn:outgoing>Flow_EditarFotos_Carrossel</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PublicarCarrossel" name="Publicar no mesmo dia carrossel no feed">
      <bpmn:incoming>Flow_EditarFotos_Carrossel</bpmn:incoming>
      <bpmn:outgoing>Flow_Carrossel_Formato</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_FormatoVideo" name="Qual formato do primeiro vídeo?">
      <bpmn:incoming>Flow_Carrossel_Formato</bpmn:incoming>
      <bpmn:outgoing>Flow_Formato_Corte</bpmn:outgoing>
      <bpmn:outgoing>Flow_Formato_Broll</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_EditarCorte" name="Editar corte com depoimento(s) ou fala(s) relevante(s)">
      <bpmn:incoming>Flow_Formato_Corte</bpmn:incoming>
      <bpmn:outgoing>Flow_Corte_PublicarVideo</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EditarResumoBroll" name="Editar vídeo curto com B-roll e resumo em texto do encontro">
      <bpmn:incoming>Flow_Formato_Broll</bpmn:incoming>
      <bpmn:outgoing>Flow_Resumo_PublicarVideo</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PublicarPrimeiroVideo" name="Publicar pelo menos 1 vídeo em 24 a 48 horas">
      <bpmn:incoming>Flow_Corte_PublicarVideo</bpmn:incoming>
      <bpmn:incoming>Flow_Resumo_PublicarVideo</bpmn:incoming>
      <bpmn:outgoing>Flow_PublicarVideo_Material</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_MaterialAdicional" name="Há material adicional relevante?">
      <bpmn:incoming>Flow_PublicarVideo_Material</bpmn:incoming>
      <bpmn:outgoing>Flow_Material_Nao</bpmn:outgoing>
      <bpmn:outgoing>Flow_Material_Sim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_CicloAposVideo" name="Ciclo mínimo concluído">
      <bpmn:incoming>Flow_Material_Nao</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_PlanejarReaproveitamento" name="Planejar reaproveitamento por até 7 dias">
      <bpmn:incoming>Flow_Material_Sim</bpmn:incoming>
      <bpmn:outgoing>Flow_Planejar_PublicarNovos</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PublicarNovosConteudos" name="Produzir e publicar novos cortes e conteúdos">
      <bpmn:incoming>Flow_Planejar_PublicarNovos</bpmn:incoming>
      <bpmn:outgoing>Flow_PublicarNovos_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_CicloCompleto" name="Ciclo de comunicação concluído">
      <bpmn:incoming>Flow_PublicarNovos_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_1saja4s" name="Retirar a foto final com todo mundo no saguão da ACIRV">
      <bpmn:incoming>Flow_Identificar_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_0hq036o</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CompartilharDemandas" name="Compartilhar demandas, elogios, críticas e sugestões">
      <bpmn:incoming>Flow_Apresentacoes_Demandas</bpmn:incoming>
      <bpmn:outgoing>Flow_Demandas_Complementar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApresentacoesParticipantes" name="Apresentar negócios, experiências e trocar contatos">
      <bpmn:incoming>Flow_Paralelo_Apresentacoes</bpmn:incoming>
      <bpmn:outgoing>Flow_Apresentacoes_Demandas</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObjectReference id="DataObjectReference_ArquivosHD" name="Arquivos brutos no HD externo" dataObjectRef="DataObject_ArquivosHD" />
    <bpmn:dataObject id="DataObject_ArquivosHD" />
    <bpmn:task id="Task_DisponibilizarCriativo" name="Disponibilizar criativo para mobilização">
      <bpmn:incoming>Flow_Criar_Disponibilizar</bpmn:incoming>
      <bpmn:outgoing>Flow_Disponibilizar_Convites</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CriarCriativo" name="Criar criativo de convite com identidade e logomarca oficiais">
      <bpmn:incoming>Flow_1oro78r</bpmn:incoming>
      <bpmn:outgoing>Flow_Criar_Disponibilizar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_Start_Verificar" sourceRef="StartEvent_SemanaIniciada" targetRef="Task_VerificarConfirmacao" />
    <bpmn:sequenceFlow id="Flow_Verificar_Confirmado" sourceRef="Task_VerificarConfirmacao" targetRef="Gateway_EventoConfirmado" />
    <bpmn:sequenceFlow id="Flow_1oro78r" sourceRef="Gateway_EventoConfirmado" targetRef="Task_CriarCriativo" />
    <bpmn:sequenceFlow id="Flow_Confirmado_Nao" name="não" sourceRef="Gateway_EventoConfirmado" targetRef="EndEvent_EventoNaoRealizado" />
    <bpmn:sequenceFlow id="Flow_Disponibilizar_Convites" sourceRef="Task_DisponibilizarCriativo" targetRef="Task_IntensificarConvites" />
    <bpmn:sequenceFlow id="Flow_Convites_Abertura" sourceRef="Task_IntensificarConvites" targetRef="Task_AberturaPresidente" />
    <bpmn:sequenceFlow id="Flow_Abertura_Paralelo" sourceRef="Task_AberturaPresidente" targetRef="Gateway_ParaleloInicio" />
    <bpmn:sequenceFlow id="Flow_Paralelo_Fotografar" name="cobertura" sourceRef="Gateway_ParaleloInicio" targetRef="Task_Fotografar" />
    <bpmn:sequenceFlow id="Flow_Paralelo_Apresentacoes" name="dinâmica&#10;do encontro" sourceRef="Gateway_ParaleloInicio" targetRef="Task_ApresentacoesParticipantes" />
    <bpmn:sequenceFlow id="Flow_Demandas_Complementar" sourceRef="Task_CompartilharDemandas" targetRef="Task_ComplementarInformacoes" />
    <bpmn:sequenceFlow id="Flow_Complementar_Join" sourceRef="Task_ComplementarInformacoes" targetRef="Gateway_ParaleloFim" />
    <bpmn:sequenceFlow id="Flow_Fotografar_Gravar" sourceRef="Task_Fotografar" targetRef="Task_GravarIntegralmente" />
    <bpmn:sequenceFlow id="Flow_Gravar_Broll" sourceRef="Task_GravarIntegralmente" targetRef="Task_CaptarBroll" />
    <bpmn:sequenceFlow id="Flow_Broll_Identificar" sourceRef="Task_CaptarBroll" targetRef="Task_IdentificarConteudos" />
    <bpmn:sequenceFlow id="Flow_Identificar_Join" sourceRef="Task_IdentificarConteudos" targetRef="Activity_1saja4s" />
    <bpmn:sequenceFlow id="Flow_0hq036o" sourceRef="Activity_1saja4s" targetRef="Gateway_ParaleloFim" />
    <bpmn:sequenceFlow id="Flow_Join_Transferir" sourceRef="Gateway_ParaleloFim" targetRef="Task_TransferirArquivos" />
    <bpmn:sequenceFlow id="Flow_Transferir_EditarFotos" sourceRef="Task_TransferirArquivos" targetRef="Task_EditarFotos" />
    <bpmn:sequenceFlow id="Flow_EditarFotos_Carrossel" sourceRef="Task_EditarFotos" targetRef="Task_PublicarCarrossel" />
    <bpmn:sequenceFlow id="Flow_Carrossel_Formato" sourceRef="Task_PublicarCarrossel" targetRef="Gateway_FormatoVideo" />
    <bpmn:sequenceFlow id="Flow_Formato_Corte" name="corte" sourceRef="Gateway_FormatoVideo" targetRef="Task_EditarCorte" />
    <bpmn:sequenceFlow id="Flow_Formato_Broll" name="Edição B-roll" sourceRef="Gateway_FormatoVideo" targetRef="Task_EditarResumoBroll" />
    <bpmn:sequenceFlow id="Flow_Corte_PublicarVideo" sourceRef="Task_EditarCorte" targetRef="Task_PublicarPrimeiroVideo" />
    <bpmn:sequenceFlow id="Flow_Resumo_PublicarVideo" sourceRef="Task_EditarResumoBroll" targetRef="Task_PublicarPrimeiroVideo" />
    <bpmn:sequenceFlow id="Flow_PublicarVideo_Material" sourceRef="Task_PublicarPrimeiroVideo" targetRef="Gateway_MaterialAdicional" />
    <bpmn:sequenceFlow id="Flow_Material_Nao" name="não" sourceRef="Gateway_MaterialAdicional" targetRef="EndEvent_CicloAposVideo" />
    <bpmn:sequenceFlow id="Flow_Material_Sim" name="sim" sourceRef="Gateway_MaterialAdicional" targetRef="Task_PlanejarReaproveitamento" />
    <bpmn:sequenceFlow id="Flow_Planejar_PublicarNovos" sourceRef="Task_PlanejarReaproveitamento" targetRef="Task_PublicarNovosConteudos" />
    <bpmn:sequenceFlow id="Flow_PublicarNovos_End" sourceRef="Task_PublicarNovosConteudos" targetRef="EndEvent_CicloCompleto" />
    <bpmn:sequenceFlow id="Flow_Apresentacoes_Demandas" sourceRef="Task_ApresentacoesParticipantes" targetRef="Task_CompartilharDemandas" />
    <bpmn:sequenceFlow id="Flow_Criar_Disponibilizar" sourceRef="Task_CriarCriativo" targetRef="Task_DisponibilizarCriativo" />
    <bpmn:association id="Association_Criativo" associationDirection="One" sourceRef="Task_CriarCriativo" targetRef="DataObjectReference_Criativo" />
    <bpmn:association id="Association_ArquivosHD" associationDirection="One" sourceRef="Task_TransferirArquivos" targetRef="DataObjectReference_ArquivosHD" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CafeComPresidente">
    <bpmndi:BPMNPlane id="BPMNPlane_CafeComPresidente" bpmnElement="Collaboration_CafeComPresidente">
      <bpmndi:BPMNShape id="Participant_CafeComPresidente_di" bpmnElement="Participant_CafeComPresidente" isHorizontal="true" bioc:stroke="#666666" bioc:fill="#ffffff" color:background-color="#ffffff" color:border-color="#666666">
